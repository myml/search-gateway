[Unit]
Description=Podman container-search-gateway.service
Documentation=man:podman-generate-systemd(1)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers
RequiresMountsFor=@ROOT@

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=on-failure
TimeoutStopSec=70
ExecStart=/usr/bin/podman run \
	--cidfile=%t/%n.ctr-id \
	--cgroups=no-conmon \
	--rm \
	--sdnotify=conmon \
	-d \
	--replace \
	--name search-gateway \
	--pull=missing \
	-p 127.0.0.1:18787:8787 \
	--env TZ=Asia/Shanghai \
	-v @DATA_DIR@:/data \
	-v @CONFIG_FILE@:/etc/search-gateway/config.json:ro \
	@IMAGE@
ExecStop=/usr/bin/podman stop \
	--ignore -t 10 \
	--cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm \
	-f \
	--ignore -t 10 \
	--cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target
