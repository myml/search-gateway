# Copy this file to /etc/search-gateway/deploy.env on the deployment host and
# replace the paths/domain with the real values. Keep the real file out of git.
SEARCH_GATEWAY_ROOT=/srv/search-gateway
SEARCH_GATEWAY_DATA=/srv/search-gateway/data
SEARCH_GATEWAY_CONFIG=/srv/search-gateway/config.json
SEARCH_GATEWAY_DOMAIN=search.example.com
SEARCH_GATEWAY_TRAEFIK_DIR=/etc/traefik/providers
