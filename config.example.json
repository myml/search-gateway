    },
    {
      "name": "brave",
      "type": "brave",
      "api_key_env": "BRAVE_API_KEY"
    },
    {
      "name": "exa",
      "type": "exa",
      "api_key_env": "EXA_API_KEY"
    },
    {
      "name": "serper",
      "type": "serper",
      "api_key_env": "SERPER_API_KEY"
    },
    {
      "name": "bocha",
      "type": "bocha",
      "api_key_env": "BOCHA_API_KEY"
    },
    {
      "name": "searxng",
      "type": "searxng",
      "base_url": "http://127.0.0.1:8888"
    }
  ],
  "fetch": [
    {
      "name": "direct",
