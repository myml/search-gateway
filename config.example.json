{
  "listen": "127.0.0.1:8787",
  "store_path": "./data/store.json",
  "db_path": "./data/gateway.db",
  "admin_tokens": ["change-admin-token"],
  "auth": {
    "tokens": ["change-client-token"]
  },
  "proxy": "",
